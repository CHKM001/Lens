{
  "name": "lens",
  "version": "0.3.0",
  "description": "Unified Stellar price API — aggregates SDEX + AMM prices",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node node_modules/prisma/build/index.js generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "node scripts/deployed-smoke.mjs",
    "test:smoke": "node --test scripts/test-deployed-smoke.mjs",
    "openapi:gen": "tsx scripts/generate-openapi.ts",
    "readme:gen": "tsx scripts/generate-readme.ts",
    "spec:validate-live": "tsx scripts/validate-live-spec.ts",
    "client:gen": "openapi-typescript openapi.yaml -o clients/typescript/src/schema.d.ts",
    "client:typecheck": "tsc -p clients/typescript/tsconfig.json --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "oracle:relay": "tsx examples/oracle-relay/relay.ts",
    "alert:bot": "tsx examples/alert-bot/alert-bot.ts",
    "mcp:server": "tsx examples/mcp-server/run.ts",
    "mcp:agent": "tsx examples/mcp-server/agent.ts",
    "key:issue": "tsx scripts/issue-api-key.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:drift-check": "bash scripts/db-drift-check.sh",
    "db:migration-cycle": "bash scripts/db-migration-cycle.sh",
    "db:migrate:partitioning": "tsx scripts/migrate-price-points-partitioning.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^5.0.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "@x402/core": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "@x402/stellar": "^2.24.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^4.5.0",
    "graphql": "^16.0.0",
    "ioredis": "^5.0.0",
    "mercurius": "^16.12.0",
    "pg": "^8.0.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "undici": "^6.29.1",
    "uuid": "^9.0.0",
    "ws": "^8.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-check": "^3.0.0",
    "js-yaml": "^4.2.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
